ANTHROPIC_API_KEY=sk-ant-...
ASSISTANT_API_KEY=your-internal-api-key
SITE_ADMIN_TOKEN=your-site-admin-token
POLSIA_SECRET=
GITHUB_PAT=ghp_...
GITHUB_REPO=https://github.com/oakc123/website-builder.git
PREVIEW_DOMAIN=preview.funkfactorymediagroup.com
OLLAMA_HOST=http://192.168.0.18:11434

# --- funkfactoryos (funkfactorymediagroup.com / funkfactorypets.com site) ---
FFMG_POSTGRES_PASSWORD=              # postgres superuser password for the funkfactoryos-db container
FFMG_ADMIN_PASSWORD=                 # login for /admin (legacy cookie panel)
FFMG_JWT_SECRET=                     # min 32 chars — generate with: openssl rand -hex 32
FFMG_ADMIN_JWT_SECRET=               # min 32 chars — new JWT admin portal (/admin/login)
FFMG_MAGIC_LINK_SECRET=              # min 32 chars — customer portal magic-link tokens
FFMG_APP_URL=https://funkfactorymediagroup.com
FFMG_PORTAL_BASE_URL=https://funkfactorymediagroup.com/portal
# ASSISTANT_API_KEY and POLSIA_SECRET above are reused directly by funkfactoryos
# to call the builder/intake services (routes/jobs.js, routes/admin-portal.js).
ASSISTANT_BASE_URL=https://builder.funkfactorymediagroup.com

# Optional — leave blank to disable the corresponding feature
STRIPE_SECRET_KEY=                   # Funk Factory Pets checkout
STRIPE_WEBHOOK_SECRET=
OWNER_EMAIL=                         # where order/contact notification emails go
AMER_ALERT_EMAIL=                    # homelab intake "new job" alert email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
POLSIA_API_KEY=                      # Polsia R2 file storage (gallery/logo uploads) + payments proxy
POLSIA_R2_BASE_URL=https://polsia.com
OPENAI_API_KEY=                      # one-off logo generation endpoint only
KLAVIYO_WEBHOOK_URL=                 # FFMG Express lead-nurture drip
GA4_MEASUREMENT_ID=
